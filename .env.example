# ---- Access ----
# Password for the web app when it's online (any username works). Leave empty locally.
APP_PASSWORD=

# ---- AI rephrasing (Anthropic) ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Instagram Content Publishing API ----
# Instagram Business/Creator account ID and a long-lived token with instagram_content_publish.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Use graph.instagram.com if your token comes from "Instagram API with Instagram Login".
IG_GRAPH_HOST=graph.instagram.com
IG_GRAPH_VERSION=v25.0
# Public HTTPS address of this app (Instagram downloads media from here), e.g. https://newsgram.onrender.com
PUBLIC_BASE_URL=

# ---- Optional: posts from the publishers' X accounts (X API v2 bearer token, paid tier) ----
X_BEARER_TOKEN=

# ---- Optional ----
# BRAND_HANDLE=@yourpage
# PORT=3000
# MOCK=1   # offline sample data for design work

# ---- Optional: video grabber ----
# Netscape-format cookies for sites that need a login (Instagram, some YouTube/X posts).
# YTDLP_COOKIES=
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# YTDLP_PATH=/usr/local/bin/yt-dlp   # use your own yt-dlp instead of ./bin/yt-dlp
