{
  "name": "newsgram",
  "version": "1.0.0",
  "description": "Turn Indian news headlines into AI-rephrased 1:1 Instagram posts and reels",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "mock": "MOCK=1 node server/index.js",
    "check-feeds": "node scripts/check-feeds.js",
    "postinstall": "node scripts/get-yt-dlp.js",
    "update-ytdlp": "node scripts/get-yt-dlp.js --force"
  },
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
